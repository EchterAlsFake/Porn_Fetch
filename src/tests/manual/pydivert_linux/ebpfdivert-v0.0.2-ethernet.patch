+    // Prefer a real Ethernet ethertype before heuristic raw-IP offsets. A MAC
+    // byte at offset 0 or 4 can otherwise look like an IPv4/IPv6 version nibble.
+    if (data + 14 + 20 <= data_end) {
+        __u16 ethertype = bpf_ntohs(*(__u16 *)((char *)data + 12));
+        if (ethertype == 0x0800 || ethertype == 0x86DD) {
+            l2_len = 14; found = 1;
+        }
+    }
+    if (!found && data + 20 <= data_end) {
